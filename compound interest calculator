<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>複利投資計算器</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --border: #21262d;
    --accent: #58a6ff;
    --green: #3fb950;
    --gold: #e3b341;
    --text: #e6edf3;
    --muted: #7d8590;
    --track: #21262d;
    --thumb: #58a6ff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Noto Sans TC', sans-serif;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    width: 100%;
    max-width: 480px;
    padding: 32px 28px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  h1 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 28px;
    text-align: center;
    text-transform: uppercase;
  }
  .input-group { margin-bottom: 24px; }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .label-text {
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .value-display {
    font-family: 'DM Mono', monospace;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    min-width: 100px;
    text-align: right;
  }
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    background: var(--track);
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--thumb);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 3px rgba(88,166,255,0.2);
    cursor: grab;
    transition: box-shadow 0.15s;
  }
  input[type="range"]:active::-webkit-slider-thumb {
    cursor: grabbing;
    box-shadow: 0 0 0 6px rgba(88,166,255,0.25);
  }
  input[type="range"]::-moz-range-thumb {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--thumb);
    border: 2px solid var(--bg);
    cursor: grab;
  }
  .divider { border: none; border-top: 1px solid var(--border); margin: 28px 0; }
  .results { display: flex; flex-direction: column; gap: 14px; }
  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
  }
  .result-row.total {
    background: rgba(88,166,255,0.07);
    border-color: rgba(88,166,255,0.25);
  }
  .result-label { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.03em; }
  .result-value { font-family: 'DM Mono', monospace; font-size: 1.1rem; font-weight: 500; }
  .result-value.principal { color: var(--accent); }
  .result-value.profit    { color: var(--green); }
  .result-value.sum       { color: var(--gold); font-size: 1.2rem; }
  .bar-wrap {
    margin-top: 20px;
    height: 8px;
    border-radius: 4px;
    background: var(--track);
    overflow: hidden;
    display: flex;
  }
  .bar-p { background: var(--accent); height: 100%; transition: width 0.3s ease; }
  .bar-r { background: var(--green);  height: 100%; transition: width 0.3s ease; }
  .bar-legend { display: flex; gap: 16px; margin-top: 8px; justify-content: flex-end; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 0.72rem; color: var(--muted); }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
</style>
</head>
<body>
<div class="card">
  <h1>複利投資計算器</h1>
  <div class="input-group">
    <div class="label-row">
      <span class="label-text">每月投資金額</span>
      <span class="value-display" id="disp-monthly">$1,000</span>
    </div>
    <input type="range" id="sl-monthly" min="100" max="50000" step="100" value="1000">
  </div>
  <div class="input-group">
    <div class="label-row">
      <span class="label-text">投資年數</span>
      <span class="value-display" id="disp-years">20 年</span>
    </div>
    <input type="range" id="sl-years" min="1" max="40" step="1" value="20">
  </div>
  <div class="input-group">
    <div class="label-row">
      <span class="label-text">年報酬率</span>
      <span class="value-display" id="disp-rate">7.0%</span>
    </div>
    <input type="range" id="sl-rate" min="1" max="20" step="0.5" value="7">
  </div>
  <hr class="divider">
  <div class="results">
    <div class="result-row">
      <span class="result-label">本金總和</span>
      <span class="result-value principal" id="out-principal">—</span>
    </div>
    <div class="result-row">
      <span class="result-label">利潤總和</span>
      <span class="result-value profit" id="out-profit">—</span>
    </div>
    <div class="result-row total">
      <span class="result-label">兩者總和</span>
      <span class="result-value sum" id="out-total">—</span>
    </div>
  </div>
  <div class="bar-wrap">
    <div class="bar-p" id="bar-p" style="width:50%"></div>
    <div class="bar-r" id="bar-r" style="width:50%"></div>
  </div>
  <div class="bar-legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--accent)"></div>本金</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--green)"></div>利潤</div>
  </div>
</div>
<script>
  const fmt = n => '$' + Math.round(n).toLocaleString('en-US');
  function calc() {
    const monthly = +document.getElementById('sl-monthly').value;
    const years   = +document.getElementById('sl-years').value;
    const rate    = +document.getElementById('sl-rate').value / 100;
    const months  = years * 12;
    const r       = rate / 12;
    const fv      = monthly * ((Math.pow(1 + r, months) - 1) / r) * (1 + r);
    const principal = monthly * months;
    const profit    = fv - principal;
    document.getElementById('out-principal').textContent = fmt(principal);
    document.getElementById('out-profit').textContent    = fmt(profit);
    document.getElementById('out-total').textContent     = fmt(fv);
    document.getElementById('bar-p').style.width = (principal / fv * 100).toFixed(1) + '%';
    document.getElementById('bar-r').style.width = (profit    / fv * 100).toFixed(1) + '%';
    document.getElementById('disp-monthly').textContent = fmt(monthly);
    document.getElementById('disp-years').textContent   = years + ' 年';
    document.getElementById('disp-rate').textContent    = (+document.getElementById('sl-rate').value).toFixed(1) + '%';
  }
  ['sl-monthly','sl-years','sl-rate'].forEach(id =>
    document.getElementById(id).addEventListener('input', calc)
  );
  calc();
</script>
</body>
</html>
